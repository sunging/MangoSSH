diff --git a/libvterm/t/63screen_resize.test b/libvterm/t/63screen_resize.test
index 6835222..3491d84 100644
--- a/libvterm/t/63screen_resize.test
+++ b/libvterm/t/63screen_resize.test
@@ -115,3 +115,18 @@ RESIZE 30,80
   ?screen_row 0 = "Alt screen"
 PUSH "\e[?1049l"
   ?screen_row 0 = "Main screen"
+
+!Resize shorter on altscreen pushes main screen lines to scrollback
+RESET
+WANTSCREEN a
+RESIZE 5,80
+PUSH "L1\r\nL2\r\nL3\r\nL4\r\nL5\e[?1049h\e[HAlt screen"
+WANTSCREEN b
+RESIZE 3,80
+  sb_pushline 80 = 4C 31
+  sb_pushline 80 = 4C 32
+  ?screen_row 0 = "Alt screen"
+WANTSCREEN -b
+PUSH "\e[?1049l"
+  ?screen_row 0 = "L3"
+  ?screen_row 2 = "L5"
