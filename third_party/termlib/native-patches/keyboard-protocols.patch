+PUSH "\e[>4;2m"
+INCHAR C 61
+  output "\e[27;5;97~"
+INCHAR A 61
+  output "\e[27;3;97~"
+INCHAR S 41
+  output "A"
+INKEY C Backspace
+  output "\e[27;5;127~"
+INKEY S Tab
+  output "\e[Z"
+INKEY C Up
+  output "\e[1;5A"
+
+!kitty takes precedence over modifyOtherKeys
+PUSH "\e[>1u"
+INKEY C Enter
+  output "\e[13;5u"
+PUSH "\e[<u"
+
+!modifyOtherKeys reset
+PUSH "\e[>4n"
+INKEY C Enter
+  output "\x0d"
+PUSH "\e[>4;2m"
+PUSH "\e[>4m"
+INKEY C Enter
+  output "\x0d"
+PUSH "\e[>4;2m"
+PUSH "\e[!p"
+INKEY C Enter
+  output "\x0d"
