--- a/android/build-android-release-assets.sh
+++ b/android/build-android-release-assets.sh
@@ -12,6 +12,9 @@ NCURSES_VERSION="${NCURSES_VERSION:-v6.4}"
 GMP_VERSION="${GMP_VERSION:-v6.2.1}"
 NETTLE_VERSION="${NETTLE_VERSION:-nettle_3.10_release_20240616}"
 
+EXTERNAL_SOURCES_DIR="${MANGOSSH_MOSH_DEPS_DIR:-}"
+EXTERNAL_PROTOC="${MANGOSSH_PROTOC:-}"
+
 die() {
   echo "error: $*" >&2
   exit 1
@@ -62,6 +65,25 @@ fetch_git() {
   fi
 }
 
+prepare_source() {
+  local dest="$1"
+  local name="$2"
+  local url="$3"
+  local ref="$4"
+  shift 4
+
+  if [[ -n "$EXTERNAL_SOURCES_DIR" ]]; then
+    local source="$EXTERNAL_SOURCES_DIR/$name"
+    [[ -d "$source" ]] || die "offline source is missing: $source"
+    rm -rf "$dest"
+    mkdir -p "$dest"
+    rsync -a --exclude .git "$source/" "$dest/"
+    return
+  fi
+
+  fetch_git "$dest" "$url" "$ref" "$@"
+}
+
 download_protoc() {
   local platform="$1"
   local dest="$WORK_DIR/protoc-$PROTOBUF_VERSION-$platform"
@@ -79,6 +101,20 @@ download_protoc() {
   echo "$dest"
 }
 
+resolve_protoc() {
+  if [[ -n "$EXTERNAL_PROTOC" ]]; then
+    [[ -x "$EXTERNAL_PROTOC" ]] || die "MANGOSSH_PROTOC is not executable"
+    local version
+    version="$("$EXTERNAL_PROTOC" --version)"
+    [[ "$version" == "libprotoc $PROTOBUF_VERSION" ]] ||
+      die "protoc $PROTOBUF_VERSION is required, found: $version"
+    echo "$EXTERNAL_PROTOC"
+    return
+  fi
+
+  echo "$(download_protoc "$(host_tag)")/bin/protoc"
+}
+
 abi_config() {
